# Copy to .env. Every value is optional; the defaults run the dry demo.

PORT=3020
HOST=127.0.0.1

# dry: real 1Click quotes with dry=true, deposits are simulated.
# live: mainnet deposit addresses, real money moves.
INTENTS_MODE=dry
ONECLICK_URL=https://1click.chaindefuser.com
ONECLICK_JWT=
SLIPPAGE_BPS=100
DEPOSIT_WINDOW_MINUTES=30
POLL_SECONDS=10

# intents (default): 1Click credits USDC on NEAR to SETTLEMENT_NEAR_ACCOUNT inside NEAR Intents.
# stellar: 1Click withdraws USDC on Stellar to SETTLEMENT_STELLAR_ADDRESS on every payment.
DELIVER_TO=intents
# The operator's NEAR account. Required in live mode with DELIVER_TO=intents.
SETTLEMENT_NEAR_ACCOUNT=
NEAR_RPC_URL=https://rpc.mainnet.near.org
# The operator's own Stellar USDC account, target of `npm run settle`.
OPERATOR_STELLAR_ADDRESS=

# Only for DELIVER_TO=stellar: the Stellar account that receives USDC from 1Click.
# Needs a USDC trustline.
SETTLEMENT_STELLAR_ADDRESS=
# Only for GAIAN_MODE=sandbox: signs the Gaian funding transaction.
SETTLEMENT_STELLAR_SECRET=

MAX_PAYMENT_USD=20

# mock: demo rates, no local currency moves. sandbox: Gaian API.
GAIAN_MODE=mock
GAIAN_HOST=https://sandbox.gaian.network
GAIAN_KEY=
GAIAN_SECRET=
GAIAN_USER_ID=
GAIAN_CHAIN_ID=148
